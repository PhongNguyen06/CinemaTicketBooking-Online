<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinema.controller.BookingsController" styleClass="root-pane">
 <left><VBox spacing="16" prefWidth="230" styleClass="sidebar">
  <Label text="CINEMA" styleClass="brand"/><Label text="BOOKINGS" styleClass="section-title"/><Separator/>
  <Button text="Back to Dashboard" onAction="#backToDashboard" maxWidth="Infinity" styleClass="nav-button"/>
 </VBox></left>
 <center><VBox spacing="14" styleClass="content">
  <HBox alignment="CENTER_LEFT"><Label fx:id="pageTitle" text="Bookings" styleClass="headline"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="greeting" styleClass="muted"/></HBox>
  <HBox spacing="12"><Button text="Refresh" onAction="#refresh" styleClass="nav-button"/><Button text="Cancel Selected Booking" onAction="#cancelSelected" styleClass="primary-button"/></HBox>
  <Label text="Select a booking to view all its tickets" styleClass="muted"/>
  <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS"><columns>
   <TableColumn fx:id="idColumn" text="Booking ID" prefWidth="100"/><TableColumn fx:id="dateColumn" text="Booked at" prefWidth="160"/>
   <TableColumn fx:id="customerColumn" text="Customer" prefWidth="170"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
   <TableColumn fx:id="totalColumn" text="Total (VND)" prefWidth="130"/>
  </columns></TableView>
  <Label text="Tickets in selected booking" styleClass="section-title"/>
  <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS"><columns>
   <TableColumn fx:id="ticketIdColumn" text="Ticket ID" prefWidth="100"/><TableColumn fx:id="movieColumn" text="Movie" prefWidth="190"/>
   <TableColumn fx:id="seatColumn" text="Seat" prefWidth="90"/><TableColumn fx:id="ticketStatusColumn" text="Status" prefWidth="110"/>
   <TableColumn fx:id="priceColumn" text="Price (VND)" prefWidth="120"/>
  </columns></TableView>
 </VBox></center>
</BorderPane>
