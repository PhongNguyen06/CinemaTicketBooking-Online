<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinema.controller.ShowtimeController" styleClass="root-pane">
    <left><VBox spacing="16" prefWidth="230" styleClass="sidebar">
        <Label text="CINEMA" styleClass="brand"/>
        <Label text="ADMIN MENU" styleClass="section-title"/>
        <Separator/>
        <Button text="Back to Dashboard" onAction="#backToDashboard" maxWidth="Infinity" styleClass="nav-button"/>
        <Label text="Showtime Management" styleClass="side-label"/>
    </VBox></left>
    <center><VBox spacing="18" styleClass="content">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Showtime Management" styleClass="headline"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="greeting" styleClass="muted"/>
        </HBox>
        <Label text="Manage screening schedules and ticket prices in showtimes.csv" styleClass="muted"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="searchType" prefWidth="135" onAction="#searchShowtimes"/>
            <TextField fx:id="searchField" promptText="Search..." HBox.hgrow="ALWAYS" onAction="#searchShowtimes"/>
            <Button text="Search" onAction="#searchShowtimes" styleClass="nav-button"/>
            <Button text="Show All" onAction="#refreshShowtimes" styleClass="nav-button"/>
        </HBox>
        <HBox spacing="12">
            <Button text="+ Add Showtime" onAction="#addShowtime" styleClass="primary-button"/>
            <Button text="Edit Selected" onAction="#editShowtime" styleClass="nav-button"/>
            <Button text="Delete Selected" onAction="#deleteShowtime" styleClass="nav-button"/>
        </HBox>
        <TableView fx:id="showtimeTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="movieColumn" text="Movie" prefWidth="170"/>
                <TableColumn fx:id="roomColumn" text="Cinema / Room" prefWidth="190"/>
                <TableColumn fx:id="startColumn" text="Start" prefWidth="135"/>
                <TableColumn fx:id="endColumn" text="End" prefWidth="135"/>
                <TableColumn fx:id="priceColumn" text="Price (VND)" prefWidth="100"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox></center>
</BorderPane>
