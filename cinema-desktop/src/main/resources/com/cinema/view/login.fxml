<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinema.controller.LoginController" styleClass="root-pane">
 <left><VBox prefWidth="450" alignment="CENTER" spacing="20" styleClass="hero-panel">
  <Label text="CINEMA" styleClass="hero-title"/><Label text="TICKET BOOKING SYSTEM" styleClass="hero-subtitle"/>
  <Label text="BOOK • WATCH • ENJOY" styleClass="muted"/>
  <Separator prefWidth="270"/><Label text="Your cinema experience starts here." styleClass="muted"/>
 </VBox></left>
 <center><VBox alignment="CENTER" spacing="16" maxWidth="350">
  <Label text="Welcome back" styleClass="headline"/>
  <Label text="Sign in to continue" styleClass="muted"/>
  <Separator prefWidth="260"/>
  <TextField fx:id="usernameField" promptText="Username" prefHeight="44"/>
  <PasswordField fx:id="passwordField" promptText="Password" prefHeight="44"/>
  <Label fx:id="messageLabel" wrapText="true" styleClass="error"/>
  <Button text="LOGIN" onAction="#handleLogin" maxWidth="Infinity" prefHeight="44" styleClass="primary-button"/>
  <Button text="Create customer account" onAction="#handleRegister" styleClass="link-button"/>
 </VBox></center>
</BorderPane>
