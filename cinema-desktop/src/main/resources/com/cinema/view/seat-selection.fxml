<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinema.controller.SeatSelectionController" styleClass="root-pane">
 <left><VBox spacing="16" prefWidth="230" styleClass="sidebar">
  <Label text="CINEMA" styleClass="brand"/><Label text="CUSTOMER MENU" styleClass="section-title"/><Separator/>
  <Button text="Back to Dashboard" onAction="#backToDashboard" maxWidth="Infinity" styleClass="nav-button"/><Label text="Seat Selection" styleClass="side-label"/>
 </VBox></left>
 <center><VBox spacing="16" styleClass="content">
  <HBox alignment="CENTER_LEFT"><Label text="Choose Your Seats" styleClass="headline"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="greeting" styleClass="muted"/></HBox>
  <Label text="Choose seats, review the total, then confirm your booking" styleClass="muted"/>
  <ComboBox fx:id="showtimeCombo" onAction="#updateSeats" promptText="Select a showtime" maxWidth="Infinity"/>
  <Label fx:id="infoLabel" styleClass="muted"/>
  <Label text="SCREEN" maxWidth="Infinity" alignment="CENTER" styleClass="screen-bar"/>
  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #141824; -fx-background-color: #141824;">
   <content><FlowPane fx:id="seatsPane" alignment="CENTER" hgap="10" vgap="10" prefWrapLength="620" style="-fx-padding: 28; -fx-background-color: #141824;"/></content>
  </ScrollPane>
  <HBox spacing="14"><Label text="Available" styleClass="legend-free"/><Label text="VIP" styleClass="legend-vip"/><Label text="Booked" styleClass="legend-booked"/><Label text="Selected" styleClass="legend-chosen"/></HBox>
  <Label fx:id="selectionLabel" text="Selected: none" styleClass="muted"/>
  <HBox alignment="CENTER_LEFT" spacing="12"><Label fx:id="totalLabel" text="Estimated total: 0 VND" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Confirm Booking" onAction="#confirmBooking" styleClass="primary-button"/></HBox>
 </VBox></center>
</BorderPane>
