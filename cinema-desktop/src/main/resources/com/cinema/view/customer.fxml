<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinema.controller.CustomerController" styleClass="root-pane">
 <left><VBox spacing="16" prefWidth="230" styleClass="sidebar">
  <Label text="CINEMA" styleClass="brand"/><Label text="ADMIN MENU" styleClass="section-title"/><Separator/>
  <Button text="Back to Dashboard" onAction="#backToDashboard" maxWidth="Infinity" styleClass="nav-button"/>
  <Label text="Customer Management" styleClass="side-label"/>
 </VBox></left>
 <center><VBox spacing="15" styleClass="content">
  <HBox alignment="CENTER_LEFT"><Label text="Customer Management" styleClass="headline"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="greeting" styleClass="muted"/></HBox>
  <Label text="Manage customers and inspect their booking history" styleClass="muted"/>
  <HBox spacing="10" alignment="CENTER_LEFT"><ComboBox fx:id="searchType" prefWidth="115"/><TextField fx:id="searchField" promptText="Search customers..." HBox.hgrow="ALWAYS" onAction="#searchCustomers"/><Button text="Search" onAction="#searchCustomers" styleClass="nav-button"/><Button text="Show All" onAction="#refreshCustomers" styleClass="nav-button"/></HBox>
  <HBox spacing="10" alignment="CENTER_LEFT"><Button text="+ Add Customer" onAction="#addCustomer" styleClass="primary-button"/><Button text="Edit Selected" onAction="#editCustomer" styleClass="nav-button"/><Button text="Delete Selected" onAction="#deleteCustomer" styleClass="nav-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="countLabel" styleClass="muted"/></HBox>
  <TableView fx:id="customerTable" prefHeight="285" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="idColumn" text="ID" prefWidth="65"/><TableColumn fx:id="nameColumn" text="Customer Name" prefWidth="235"/><TableColumn fx:id="emailColumn" text="Email" prefWidth="275"/><TableColumn fx:id="phoneColumn" text="Phone" prefWidth="160"/></columns></TableView>
  <Label text="Booking History — Select a Customer" styleClass="section-title"/>
  <TableView fx:id="bookingTable" prefHeight="190" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="bookingIdColumn" text="Booking ID" prefWidth="110"/><TableColumn fx:id="bookingDateColumn" text="Booking Date" prefWidth="220"/><TableColumn fx:id="bookingStatusColumn" text="Status" prefWidth="150"/><TableColumn fx:id="bookingTotalColumn" text="Total (VND)" prefWidth="150"/></columns></TableView>
 </VBox></center>
</BorderPane>
